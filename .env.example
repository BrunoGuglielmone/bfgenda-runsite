# Copia este archivo como .env únicamente si necesitas configurarlo manualmente.
# El instalador de BFGenda genera un .env privado automáticamente.

AGENDE_SECRET_KEY=cambia-este-valor-por-una-clave-larga-y-privada
AGENDE_DEBUG=0
AGENDE_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.19
AGENDE_CSRF_TRUSTED_ORIGINS=
AGENDE_HOST=0.0.0.0
AGENDE_PORT=8000
AGENDE_THREADS=4
AGENDE_BROWSER_URL=http://127.0.0.1:8000/
AGENDE_BROWSER=chrome

# Apagado seguro desde el login después de cerrar sesión localmente.
AGENDE_WEB_SHUTDOWN_ENABLED=1
AGENDE_WEB_SHUTDOWN_WINDOW_SECONDS=600
AGENDE_WEB_SHUTDOWN_DELAY_SECONDS=3

# Rutas persistentes configurables para un host administrado.
AGENDE_DATABASE_PATH=
AGENDE_BACKUP_DIR=
AGENDE_STATIC_ROOT=
AGENDE_LOG_DIR=

# Seguridad HTTPS de producción.
AGENDE_SESSION_COOKIE_SECURE=0
AGENDE_CSRF_COOKIE_SECURE=0
AGENDE_SECURE_SSL_REDIRECT=0
AGENDE_TRUST_X_FORWARDED_PROTO=0
AGENDE_SECURE_HSTS_SECONDS=0
AGENDE_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
AGENDE_SECURE_HSTS_PRELOAD=0

# Web Push (la clave privada nunca se guarda en Git).
AGENDE_VAPID_PUBLIC_KEY=
AGENDE_VAPID_PRIVATE_KEY=
AGENDE_VAPID_SUBJECT=mailto:tu-correo@example.com
AGENDE_PUSH_SCHEDULER_ENABLED=0
AGENDE_PUSH_SCHEDULER_INTERVAL_SECONDS=60
