# Variables públicas del servicio. Reemplazar los dos dominios cuando
# Northflank asigne la URL definitiva.
AGENDE_DEBUG=0
AGENDE_ALLOWED_HOSTS=bfgenda--proyecto.code.run
AGENDE_CSRF_TRUSTED_ORIGINS=https://bfgenda--proyecto.code.run
AGENDE_HOST=0.0.0.0
AGENDE_PORT=8080
AGENDE_THREADS=4
AGENDE_WEB_SHUTDOWN_ENABLED=0
AGENDE_SESSION_COOKIE_SECURE=1
AGENDE_CSRF_COOKIE_SECURE=1
AGENDE_SECURE_SSL_REDIRECT=0
AGENDE_TRUST_X_FORWARDED_PROTO=1
AGENDE_SECURE_HSTS_SECONDS=3600
AGENDE_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
AGENDE_SECURE_HSTS_PRELOAD=0
AGENDE_AUTOMATIC_BACKUPS=0
AGENDE_PUSH_SCHEDULER_ENABLED=1
AGENDE_PUSH_SCHEDULER_INTERVAL_SECONDS=60

# Secretos: se configuran únicamente en un Secret Group de Northflank.
# El addon PostgreSQL expone POSTGRES_URI; puede usarse DATABASE_URL como alias.
POSTGRES_URI=
AGENDE_SECRET_KEY=
AGENDE_VAPID_PUBLIC_KEY=
AGENDE_VAPID_PRIVATE_KEY=
AGENDE_VAPID_SUBJECT=
