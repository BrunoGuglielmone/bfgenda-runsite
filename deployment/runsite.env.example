# Sustituir DOMINIO y los secretos; no publicar valores reales en Git.
AGENDE_SECRET_KEY=generar-una-clave-django-larga-y-unica
AGENDE_DEBUG=0
AGENDE_ALLOWED_HOSTS=DOMINIO.runsite.app
AGENDE_CSRF_TRUSTED_ORIGINS=https://DOMINIO.runsite.app

# El mismo punto de montaje debe configurarse como disco persistente.
AGENDE_DATABASE_PATH=/data/bfgenda/db.sqlite3
AGENDE_BACKUP_DIR=/data/bfgenda/backups
AGENDE_LOG_DIR=/data/bfgenda/logs

AGENDE_HOST=0.0.0.0
AGENDE_PORT=8080
AGENDE_THREADS=4
AGENDE_WEB_SHUTDOWN_ENABLED=0

AGENDE_SESSION_COOKIE_SECURE=1
AGENDE_CSRF_COOKIE_SECURE=1
AGENDE_SECURE_SSL_REDIRECT=0
AGENDE_TRUST_X_FORWARDED_PROTO=1
AGENDE_SECURE_HSTS_SECONDS=3600
AGENDE_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
AGENDE_SECURE_HSTS_PRELOAD=0

AGENDE_VAPID_PUBLIC_KEY=
AGENDE_VAPID_PRIVATE_KEY=/data/bfgenda/secrets/vapid-private.pem
AGENDE_VAPID_SUBJECT=mailto:TU_CORREO
# Activar después de generar la pareja VAPID y guardar la clave pública.
AGENDE_PUSH_SCHEDULER_ENABLED=0
AGENDE_PUSH_SCHEDULER_INTERVAL_SECONDS=60
