# Sustituir los secretos; no publicar valores reales en Git.
AGENDE_SECRET_KEY=generar-una-clave-django-larga-y-unica
AGENDE_DEBUG=0
# Agregar el hostname interno exacto que Runsite use para su health check.
AGENDE_ALLOWED_HOSTS=.runsite.app
AGENDE_CSRF_TRUSTED_ORIGINS=https://*.runsite.app

# /data es efimero en Free; Litestream lo restaura desde S3 al iniciar.
AGENDE_DATABASE_PATH=/data/bfgenda/db.sqlite3
AGENDE_BACKUP_DIR=/data/bfgenda/backups
AGENDE_LOG_DIR=/data/bfgenda/logs

# Bucket privado de Runsite Object Storage y clave limitada a ese bucket.
LITESTREAM_BUCKET=bfgenda-db
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

AGENDE_HOST=0.0.0.0
AGENDE_PORT=8080
AGENDE_THREADS=4
AGENDE_WEB_SHUTDOWN_ENABLED=0

AGENDE_SESSION_COOKIE_SECURE=1
AGENDE_CSRF_COOKIE_SECURE=1
AGENDE_SECURE_SSL_REDIRECT=0
AGENDE_TRUST_X_FORWARDED_PROTO=1
AGENDE_SECURE_HSTS_SECONDS=3600
AGENDE_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
AGENDE_SECURE_HSTS_PRELOAD=0

AGENDE_VAPID_PUBLIC_KEY=
AGENDE_VAPID_PRIVATE_KEY=clave-privada-der-en-base64url
AGENDE_VAPID_SUBJECT=https://bfgenda.runsite.app
AGENDE_PUSH_SCHEDULER_ENABLED=1
AGENDE_PUSH_SCHEDULER_INTERVAL_SECONDS=60
